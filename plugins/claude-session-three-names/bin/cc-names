#!/usr/bin/env python3
"""cc-names: keep a Claude Code session's three names in agreement.

A session has three names that nothing keeps in sync:
  peer address     ListAgents / SendMessage; ``claude -n`` or ``/rename``
  Remote Control   ``claude --remote-control <name>``
  cmux tab title   ``cmux tab-action --action rename``

The peer-address name is readable from ``~/.claude/sessions/<pid>.json``
(fields ``name`` and ``nameSource``: ``user`` after ``-n`` or ``/rename``,
``derived`` otherwise). The tab title is readable from ``cmux tree``. This
tool joins the two and pushes the session name to the tab.

  cc-names who                      table of live sessions with their tab
  cc-names pick [NAME] [--no-prompt]   resolve a launch name; exit 3 on collision
  cc-names sync [--all] [--dry-run]    rename tabs to match user-set session names
  cc-names sync --hook [--dry-run]     same, for the one session named in the
                                       Claude Code hook JSON on stdin

Stdlib only; runs on the system python3 of macOS.
"""

import glob
import json
import os
import re
import subprocess
import sys

SESSIONS_DIR = os.path.expanduser("~/.claude/sessions")
SHELL_TITLES = {"", "bash", "zsh", "sh", "fish", "-bash", "-zsh", "login", "terminal"}


def run(cmd, stdin=None):
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=10, input=stdin)
        retval = proc.returncode, proc.stdout, proc.stderr
    except (OSError, subprocess.TimeoutExpired) as exc:
        retval = 1, "", str(exc)
    return retval


def cmux_surfaces():
    """Return {tty: {"surface": ref, "workspace": title, "tab": title}} from ``cmux tree --all``."""
    _, out, _ = run(["cmux", "tree", "--all"])
    surfaces = {}
    workspace = "-"
    for line in out.splitlines():
        ws = re.search(r'workspace workspace:\d+ "([^"]*)"', line)
        if ws:
            workspace = ws.group(1)
            continue
        surf = re.search(r'surface (surface:\d+) \[terminal\] "([^"]*)".*tty=(ttys\d+)', line)
        if surf:
            surfaces[surf.group(3)] = {"surface": surf.group(1), "workspace": workspace, "tab": surf.group(2)}
    retval = surfaces
    return retval


def pid_tty(pid):
    _, out, _ = run(["ps", "-o", "tty=,lstart=", "-p", str(pid)])
    parts = out.split()
    if not parts:
        retval = None, None
    else:
        retval = parts[0], " ".join(parts[1:5])
    return retval


def live_sessions():
    """Every registry entry whose pid is alive, joined to its cmux surface."""
    surfaces = cmux_surfaces()
    sessions = []
    for path in sorted(glob.glob(os.path.join(SESSIONS_DIR, "*.json"))):
        try:
            data = json.load(open(path))
        except (OSError, ValueError):
            continue
        pid = data.get("pid")
        tty, started = pid_tty(pid) if pid else (None, None)
        if tty is None:
            continue
        surf = surfaces.get(tty, {})
        sessions.append({
            "pid": pid,
            "session_id": data.get("sessionId", ""),
            "name": data.get("name", ""),
            "source": data.get("nameSource", "") or "-",
            "kind": data.get("kind", ""),
            "status": data.get("status", ""),
            "cwd": data.get("cwd", ""),
            "tty": tty,
            "started": started,
            "surface": surf.get("surface", "-"),
            "workspace": surf.get("workspace", "-"),
            "tab": surf.get("tab", "-"),
        })
    retval = sessions
    return retval


def caller_surface():
    """Surface ref of the terminal this process runs in, via ``cmux identify``."""
    rc, out, _ = run(["cmux", "identify"])
    ref = None
    if rc == 0:
        try:
            ref = json.loads(out).get("caller", {}).get("surface_ref")
        except ValueError:
            ref = None
    retval = ref
    return retval


def rename_tab(surface, title, dry_run):
    cmd = ["cmux", "tab-action", "--action", "rename", "--surface", surface, "--title", title]
    if dry_run:
        print("would run:", " ".join(cmd))
        retval = 0
    else:
        rc, _, err = run(cmd)
        if rc != 0:
            print("rename failed:", err.strip(), file=sys.stderr)
        retval = rc
    return retval


def cmd_who(_args):
    rows = live_sessions()
    print("PID\tNAME\tSRC\tSTATUS\tTTY\tWORKSPACE\tTAB\tMATCH")
    for s in rows:
        if s["tab"] == "-":
            match = "-"
        elif s["tab"] == s["name"]:
            match = "ok"
        else:
            match = "differs"
        print("\t".join(str(s[k]) for k in ("pid", "name", "source", "status", "tty", "workspace", "tab")) + "\t" + match)
    retval = 0
    return retval


def sanitize(name):
    retval = re.sub(r"\s+", "-", name.strip())
    return retval


def cmd_pick(args):
    """Print the name a launch wrapper should use. Exit 3 if it collides and --no-prompt."""
    explicit = next((a for a in args if not a.startswith("--")), None)
    no_prompt = "--no-prompt" in args
    cwd_base = os.path.basename(os.getcwd())
    surfaces = cmux_surfaces()
    my_surface = caller_surface()
    my_tab = next((v["tab"] for v in surfaces.values() if v["surface"] == my_surface), "")
    if explicit:
        name, origin = sanitize(explicit), "argument"
    elif my_tab.lower() not in SHELL_TITLES and my_tab != cwd_base:
        name, origin = sanitize(my_tab), "tab title"
    else:
        name, origin = sanitize(cwd_base), "folder"
    taken = set()
    for s in live_sessions():
        if s["surface"] != my_surface:
            taken.add(s["name"])
            if s["tab"] != "-":
                taken.add(s["tab"])
    if name in taken:
        print(f"collision: '{name}' ({origin}) is already a live session or tab name", file=sys.stderr)
        retval = 3
        if not no_prompt:
            print(name)
    else:
        print(name)
        retval = 0
    return retval


def cmd_sync(args):
    dry_run = "--dry-run" in args
    hook = "--hook" in args
    rows = live_sessions()
    if hook:
        try:
            payload = json.load(sys.stdin)
        except ValueError:
            payload = {}
        sid = payload.get("session_id", "")
        rows = [s for s in rows if s["session_id"] == sid]
        surface = caller_surface()
        if rows and surface:
            rows[0]["surface"] = surface
    elif "--all" not in args:
        surface = caller_surface()
        rows = [s for s in rows if s["surface"] == surface]
    retval = 0
    for s in rows:
        if s["source"] != "user" or s["surface"] == "-":
            continue
        if s["tab"] != s["name"] or hook:
            rc = rename_tab(s["surface"], s["name"], dry_run)
            retval = retval or rc
    return retval


def main():
    args = sys.argv[1:]
    verb = args[0] if args else "who"
    handlers = {"who": cmd_who, "pick": cmd_pick, "sync": cmd_sync}
    if verb not in handlers:
        print(__doc__)
        retval = 2
    else:
        retval = handlers[verb](args[1:])
    return retval


if __name__ == "__main__":
    sys.exit(main())
