#!/usr/bin/env bash
#
# pre-push - run the full pre-publish gate before anything leaves this machine.
#
# Enable per-clone (git does NOT pick this up automatically):
#
#   git config core.hooksPath hooks
#
# Why a hook and not just CI: the sensitive-term gate has two halves. The
# structural half (key/token/account-id shapes, private IPs, internal-domain
# hostnames) runs fine in CI. The NAME half reads a private wordlist that must
# stay out of this public repo, so CI cannot run it - and an Actions secret
# would not reach fork PRs, meaning the job would report green without having
# checked anything. Names are therefore enforced here, where the wordlist
# already lives (~/.config/skillz/sensitive-terms.txt by default).
#
# Skip once, deliberately: git push --no-verify
#
# bash 3.2 compatible (macOS default).

set -u

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root" || exit 1

fail=0

# A capture branch per skill-capture-pr-handoff carries skills/<name>/ content
# and deliberately NO registry files, so validate-catalog's "SKILL.md but no
# catalog.json entry" check fails by construction - and the contract forbids the
# only fix that check accepts. Three sessions hit this; two pushed --no-verify
# (silencing the sensitive-term gate too) and one abandoned the push entirely.
#
# So detect that exact shape - every changed path under skills/, and at least
# one - and demote that one error to a warning. Any registry file, plugin file
# or README in the diff means this is NOT a capture branch and the check stands.
# CI never sets this, so the landing side still enforces it.
#
# `case`, deliberately not `grep -qv`: the grep on this machine returns 1 from
# -qv on input whose first line does NOT match, which flips the test and marks
# every branch a capture branch - including ones that rewrite catalog.json.
# .github/workflows/release.yml carries the same warning for the same reason.
changed=$(git diff --name-only origin/master...HEAD 2>/dev/null || true)
capture=0
if [ -n "$changed" ]; then
  capture=1
  while IFS= read -r f; do
    case "$f" in
      skills/*) ;;
      *) capture=0; break ;;
    esac
  done <<EOF
$changed
EOF
fi
if [ "$capture" -eq 1 ]; then
  export SKILLZ_CAPTURE_BRANCH=1
  echo "pre-push: content-only capture branch (nothing outside skills/);"
  echo "          the catalog-entry check is the landing side's to satisfy."
fi

echo "pre-push: validating catalog..."
if ! bash scripts/validate-catalog.sh; then
  fail=1
fi

echo "pre-push: sensitive-term gate..."
# Same paths as CI, plus the wordlist half via the default
# ~/.config/skillz/sensitive-terms.txt (or $SKILLZ_SENSITIVE_TERMS_FILE).
if ! bash scripts/check-sensitive-terms.sh \
       skills/ docs/ plugins/ README.md catalog.json; then
  fail=1
fi

echo "pre-push: plugin version bumps..."
# The gate that is easiest to miss: CI's `version-bumped` job fails a PR whose
# touched plugins did not bump. Catching it here costs a second; catching it in
# CI costs a round trip, and the failure names a file you have already pushed.
# Needs origin/master to compare against - if the ref is missing, say so rather
# than passing silently, since a silent pass is exactly the failure mode.
if git rev-parse --verify --quiet origin/master >/dev/null; then
  if ! python3 scripts/check-plugin-version-bumps.py origin/master; then
    fail=1
  fi
else
  echo "pre-push: origin/master not present - run 'git fetch origin master' to enable the version-bump check" >&2
  fail=1
fi

if [ "$fail" -ne 0 ]; then
  echo "" >&2
  echo "pre-push: BLOCKED - fix the above before pushing." >&2
  echo "pre-push: to override deliberately: git push --no-verify" >&2
  exit 1
fi

echo "pre-push: clean"
exit 0
