#!/usr/bin/env bash
#
# pre-push - run the full pre-publish gate before anything leaves this machine.
#
# Enable per-clone (git does NOT pick this up automatically):
#
#   git config core.hooksPath hooks
#
# Why a hook and not just CI: the sensitive-term gate has two halves. The
# structural half (key/token/account-id shapes, private IPs, internal-domain
# hostnames) runs fine in CI. The NAME half reads a private wordlist that must
# stay out of this public repo, so CI cannot run it - and an Actions secret
# would not reach fork PRs, meaning the job would report green without having
# checked anything. Names are therefore enforced here, where the wordlist
# already lives (~/.config/skillz/sensitive-terms.txt by default).
#
# Skip once, deliberately: git push --no-verify
#
# What this hook judges: only the refs actually being pushed, read from stdin as
# `<local ref> <local sha> <remote ref> <remote sha>` per ref. A deletion has an
# all-zero LOCAL sha. Two consequences, both of them fixes for real failures:
#
#   - A push whose every ref is a deletion carries no content, so there is
#     nothing to validate and the hook exits 0. It used to run the whole suite
#     against the checked-out tree, which with a stale origin/master produced a
#     wall of "still X - bump it" naming plugins the deletion never touched.
#     Hit while deleting 52 merged branches; it read as real breakage.
#   - Every check here reads the WORKING TREE, so it can only speak for the ref
#     that is checked out. Pushing some other branch is refused with a message
#     rather than silently validating the wrong tree.
#
# bash 3.2 compatible (macOS default).

set -u

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root" || exit 1

fail=0

# ---------------------------------------------------------------------------
# Read the pushed refs from stdin. git always supplies them; a manual run with
# no stdin (or a closed one) yields nothing, and we then fall through to
# checking the working tree, which is the old behaviour and the safe default.
# ---------------------------------------------------------------------------
head_sha=$(git rev-parse HEAD 2>/dev/null || echo "")
refs_seen=0
content_refs=0
mismatched=""
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_ref:-}" ] || continue
  refs_seen=$((refs_seen + 1))
  case "$local_sha" in
    *[!0]*)
      # a real sha: this ref carries content
      content_refs=$((content_refs + 1))
      if [ -n "$head_sha" ] && [ "$local_sha" != "$head_sha" ]; then
        mismatched="$mismatched $remote_ref"
      fi
      ;;
    *)
      # all zeros (or empty): a deletion, nothing to validate
      ;;
  esac
done

if [ "$refs_seen" -gt 0 ] && [ "$content_refs" -eq 0 ]; then
  echo "pre-push: deletion-only push ($refs_seen ref(s)) - no content to check."
  exit 0
fi

if [ -n "$mismatched" ]; then
  echo "pre-push: refusing to validate a ref that is not checked out:$mismatched" >&2
  echo "pre-push: every check here reads the working tree, so it can only speak" >&2
  echo "          for HEAD ($(git rev-parse --abbrev-ref HEAD 2>/dev/null))." >&2
  echo "pre-push: check out the branch you are pushing, or override with --no-verify." >&2
  exit 1
fi

# A capture branch per skill-capture-pr-handoff carries skills/<name>/ content
# and deliberately NO registry files, so validate-catalog's "SKILL.md but no
# catalog.json entry" check fails by construction - and the contract forbids the
# only fix that check accepts. Three sessions hit this; two pushed --no-verify
# (silencing the sensitive-term gate too) and one abandoned the push entirely.
#
# So detect that exact shape - every changed path under skills/, and at least
# one - and demote that one error to a warning. Any registry file, plugin file
# or README in the diff means this is NOT a capture branch and the check stands.
# CI never sets this, so the landing side still enforces it.
#
# `case`, deliberately not `grep -qv`: the grep on this machine returns 1 from
# -qv on input whose first line does NOT match, which flips the test and marks
# every branch a capture branch - including ones that rewrite catalog.json.
# .github/workflows/release.yml carries the same warning for the same reason.
changed=$(git diff --name-only origin/master...HEAD 2>/dev/null || true)
capture=0
if [ -n "$changed" ]; then
  capture=1
  while IFS= read -r f; do
    case "$f" in
      skills/*) ;;
      *) capture=0; break ;;
    esac
  done <<EOF
$changed
EOF
fi
if [ "$capture" -eq 1 ]; then
  export SKILLZ_CAPTURE_BRANCH=1
  echo "pre-push: content-only capture branch (nothing outside skills/);"
  echo "          the catalog-entry check is the landing side's to satisfy."
fi

echo "pre-push: validating catalog..."
if ! bash scripts/validate-catalog.sh; then
  fail=1
fi

echo "pre-push: sensitive-term gate..."
# Same paths as CI, plus the wordlist half via the default
# ~/.config/skillz/sensitive-terms.txt (or $SKILLZ_SENSITIVE_TERMS_FILE).
if ! bash scripts/check-sensitive-terms.sh \
       skills/ docs/ plugins/ README.md catalog.json; then
  fail=1
fi

echo "pre-push: plugin version bumps..."
# The gate that is easiest to miss: CI's `version-bumped` job fails a PR whose
# touched plugins did not bump. Catching it here costs a second; catching it in
# CI costs a round trip, and the failure names a file you have already pushed.
# Needs origin/master to compare against - if the ref is missing, say so rather
# than passing silently, since a silent pass is exactly the failure mode.
if [ "$capture" -eq 1 ]; then
  # Same reasoning as the catalog-entry check above. Version bumps are the
  # LANDING side's job under skill-capture-pr-handoff, and the contract forbids
  # the capture side from touching plugins/ at all - so a capture branch that
  # edits an EXISTING skill fails this check by construction and has no
  # permitted fix. Two sessions hit it independently and both correctly refused
  # to --no-verify. CI still enforces it, on the side that owes it.
  echo "pre-push: skipped - version bumps are the landing side's to supply."
elif git rev-parse --verify --quiet origin/master >/dev/null; then
  # A STALE local origin/master makes this check lie: it reads master's newer
  # content as this push's changes and demands bumps for plugins never touched.
  # The remote is already being contacted by the push itself, so one ls-remote
  # is cheap, and saying "fetch" is far better than printing those errors.
  # `${1:-origin}` is the remote git passes as the hook's first argument.
  remote_name=${1:-origin}
  remote_master=$(git ls-remote --heads "$remote_name" master 2>/dev/null | cut -f1)
  local_master=$(git rev-parse origin/master)
  if [ -n "$remote_master" ] && [ "$remote_master" != "$local_master" ] \
     && git merge-base --is-ancestor "$local_master" "$remote_master" 2>/dev/null; then
    behind=$(git rev-list --count "$local_master..$remote_master" 2>/dev/null || echo "?")
    echo "pre-push: local origin/master is $behind commit(s) behind $remote_name/master." >&2
    echo "pre-push: the version-bump check would report bumps owed for plugins this" >&2
    echo "          push never touched. Run: git fetch $remote_name master" >&2
    fail=1
  elif ! python3 scripts/check-plugin-version-bumps.py origin/master; then
    fail=1
  fi
else
  echo "pre-push: origin/master not present - run 'git fetch origin master' to enable the version-bump check" >&2
  fail=1
fi

if [ "$fail" -ne 0 ]; then
  echo "" >&2
  echo "pre-push: BLOCKED - fix the above before pushing." >&2
  echo "pre-push: to override deliberately: git push --no-verify" >&2
  exit 1
fi

echo "pre-push: clean"
exit 0
